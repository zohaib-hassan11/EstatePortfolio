# ---------------------------------------------------------------------------
# Production .env for Hostinger shared hosting.
# Copy to `.env` ON THE SERVER, fill in the blanks, then run:
#   php artisan key:generate
# Never commit the real .env - it is gitignored for a reason.
# ---------------------------------------------------------------------------

APP_NAME="ZH Estates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_TIMEZONE=Asia/Karachi

# --- Database: create it in hPanel > Databases > MySQL, then paste the values.
# Hostinger prefixes the names it gives you, e.g. u123456789_estate
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- File-based drivers: no Redis on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Email. Create the mailbox in hPanel > Emails, then use those credentials.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demo mode: pre-fills the admin login and shows the credentials on screen.
# Set to false the moment this site holds anything real.
DEMO_LOGIN=true
DEMO_LOGIN_PASSWORD=change-this-before-going-live

# --- SEO. Paste from Search Console / Bing Webmaster Tools once verified.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
