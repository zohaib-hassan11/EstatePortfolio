APP_NAME="Carter Property Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ENQUIRY_CONFIRMATION_EMAIL=true
# Answer each form enquiry by email with an AI reply checked against the listing
# records (falls back to the plain confirmation). Needs an AI key and real mail.
AI_ENQUIRY_REPLY=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI reply drafts in the enquiry inbox. Leave the key blank and the feature
# simply does not appear - the admin works exactly as it does without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# OpenRouter instead of Anthropic: fill this key and it is used automatically.
# Model names come from openrouter.ai/models, e.g. openai/gpt-4o.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_CHAT_MAX_TOKENS=1024

# Public property assistant (chat bubble). Same key as above.
AI_CHAT_ENABLED=true
AI_CHAT_MODEL=claude-opus-5-5
AI_CHAT_EFFORT=low
# Simple questions (price, size, hours...) are answered from the database for free.
AI_CHAT_QUICK_ANSWERS=true
AI_CHAT_HISTORY=12

# Portfolio demo: pre-fills the admin login and shows the credentials on screen.
# Set to false before this site holds anything real.
DEMO_LOGIN=true

# Phone agent (Retell voice agent + n8n). The /api/v1 API stays closed until
# this is set - see docs/phone-agent.md. Generate with: openssl rand -hex 32
AUTOMATION_API_TOKEN=
# true: viewings booked on a call are confirmed at once; false: you confirm them.
APPOINTMENTS_AUTO_CONFIRM=false
